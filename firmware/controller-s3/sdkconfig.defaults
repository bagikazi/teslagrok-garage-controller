CONFIG_IDF_TARGET="esp32s3"
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_GARAGE_ENABLE_RELAY=n
CONFIG_GARAGE_WIFI_SSID=""
CONFIG_GARAGE_WIFI_PASSWORD=""
CONFIG_GARAGE_MQTT_URI="mqtts://garage.example.invalid:8883"
CONFIG_GARAGE_DEVICE_ID="controller-s3-001"
CONFIG_GARAGE_MQTT_USERNAME=""
CONFIG_GARAGE_MQTT_PASSWORD=""
CONFIG_GARAGE_RELAY_PULSE_MS=300
CONFIG_GARAGE_RELAY_INTERLOCK_MS=100
CONFIG_GARAGE_REOPEN_DELAY_MS=400
CONFIG_GARAGE_HCSR04_OBSTACLE_CM=12
CONFIG_GARAGE_TOF_OBSTACLE_CM=12
CONFIG_GARAGE_HCSR04_WARNING_CM=20
CONFIG_GARAGE_TOF_WARNING_CM=20
CONFIG_GARAGE_SENSOR_FAULT_TIMEOUT_MS=1500
CONFIG_GARAGE_SENSOR_DISAGREEMENT_CM=10
CONFIG_GARAGE_PIR_LIGHT_ENABLED=y
CONFIG_GARAGE_PIR_LIGHT_TIMEOUT_SECONDS=120
CONFIG_GARAGE_FIRMWARE_VERSION="0.1.0-diagnostic"
CONFIG_LV_COLOR_DEPTH=16
CONFIG_LWIP_DHCP_RESTORE_LAST_IP=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
