CONFIG_IDF_TARGET="esp32"
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_GARAGE_CAMERA_BOARD_PROFILE="AI_THINKER_ESP32_CAM"
CONFIG_GARAGE_CAMERA_BOARD_AI_THINKER=y
CONFIG_GARAGE_CAMERA_WIFI_SSID=""
CONFIG_GARAGE_CAMERA_WIFI_PASSWORD=""
CONFIG_GARAGE_CAMERA_MQTT_URI="mqtts://garage.example.invalid:8883"
CONFIG_GARAGE_CAMERA_ID="camera-esp32cam-001"
CONFIG_GARAGE_CAMERA_GARAGE_ID="garage-01"
CONFIG_GARAGE_CAMERA_FIRMWARE_VERSION="0.2.0"
CONFIG_GARAGE_CAMERA_UPLOAD_URL="https://garage.example.invalid/api/camera/upload"
CONFIG_GARAGE_CAMERA_UPLOAD_TOKEN=""
CONFIG_GARAGE_CAMERA_DEVICE_TOKEN=""
CONFIG_GARAGE_CAMERA_MQTT_USERNAME=""
CONFIG_GARAGE_CAMERA_MQTT_PASSWORD=""
CONFIG_GARAGE_CAMERA_INGEST_SCHEME="wss"
CONFIG_WS_TRANSPORT=y
