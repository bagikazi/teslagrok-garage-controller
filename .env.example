NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://garage:change-me@localhost:5432/garage
MQTT_URL=mqtts://localhost:8883
MQTT_USERNAME=backend
MQTT_PASSWORD=change-me
MQTT_CA_FILE=
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
CAMERA_UPLOAD_TOKEN=replace-with-a-device-specific-token
CAMERA_DATA_DIR=./data/camera
CAMERA_INGEST_HOST=garage.example.com
CAMERA_INGEST_PORT=20000
CAMERA_DEVICE_TOKEN=replace-with-a-random-32-plus-character-camera-device-token
CAMERA_SESSION_TTL=10m
CAMERA_IDLE_TIMEOUT=10s
CAMERA_MAX_SESSION=10m
CAMERA_MAX_FRAME_BYTES=524288
CAMERA_MAX_FPS=5
DEFAULT_GARAGE_ID=garage-01
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
DEFAULT_DEVICE_ID=controller-s3-001
DEFAULT_CAMERA_ID=camera-esp32cam-001
# Grok custom connector (MCP). Empty MCP_TOKEN disables /api/mcp.
# Connector URL: https://<host>/api/mcp/<MCP_TOKEN>. MCP_OPEN_PIN (4-8 digits) is asked before opening.
MCP_TOKEN=
MCP_OPEN_PIN=
