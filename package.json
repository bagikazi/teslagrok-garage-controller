{
  "name": "garage-control",
  "version": "0.1.0",
  "private": true,
  "description": "Production-oriented remote garage door monitoring and control monorepo",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "packages/*",
    "server/api",
    "web",
    "tools/mock-device"
  ],
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "dev:api": "npm --workspace server/api run dev",
    "dev:web": "npm --workspace web run dev",
    "dev:mock": "npm --workspace tools/mock-device run dev",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
