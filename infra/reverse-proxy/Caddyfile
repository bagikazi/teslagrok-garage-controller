{$GARAGE_DOMAIN} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Content-Security-Policy "default-src 'self'; img-src 'self' data:; connect-src 'self' wss: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
  }
  handle /api/* { reverse_proxy api:4000 }
  handle /ws { reverse_proxy api:4000 }
  handle { reverse_proxy web:3000 }
}

# The camera opens an outbound WebSocket to this isolated listener. Keep it
# separate from browser/API traffic and expose only the authenticated ingest path.
{$GARAGE_DOMAIN}:20000 {
  reverse_proxy api:20000
}
